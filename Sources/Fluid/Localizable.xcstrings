{
  "sourceLanguage": "en",
  "strings": {
    "\"Create a folder called Projects on Desktop\"": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Utwórz folder Projekty na Biurku”"
          }
        }
      }
    },
    "\"List files in my Downloads folder\"": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Pokaż pliki w folderze Pobrane”"
          }
        }
      }
    },
    "\"Open Safari\"": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Otwórz Safari”"
          }
        }
      }
    },
    "\"What's my IP address?\"": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jaki jest mój adres IP?”"
          }
        }
      }
    },
    "%@ (System Default)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (domyślny systemowy)"
          }
        }
      }
    },
    "%@ for Command Mode is coming soon. Choose a verified chat provider or turn Sync off.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ w Trybie poleceń będzie dostępny wkrótce. Wybierz zweryfikowanego dostawcę czatu albo wyłącz synchronizację."
          }
        }
      }
    },
    "%@ for Edit Mode is coming soon": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dla Trybu edycji już wkrótce"
          }
        }
      }
    },
    "%@ is already recognized correctly.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest już rozpoznawane poprawnie."
          }
        }
      }
    },
    "%@ uses its own built-in system prompt. Switch to another provider to create custom prompts.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używa własnego wbudowanego promptu systemowego. Przełącz się na innego dostawcę, aby tworzyć własne prompty."
          }
        }
      }
    },
    "%@ words": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ słów"
          }
        }
      }
    },
    "%@. Higher values help long transcripts but use more RAM.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Wyższe wartości pomagają przy długich transkrypcjach, ale zużywają więcej RAM."
          }
        }
      }
    },
