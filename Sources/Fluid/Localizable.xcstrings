      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "25 języków"
          }
        }
      }
    },
    "30 Languages": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "30 języków"
          }
        }
      }
    },
    "30 days": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dni"
          }
        }
      }
    },
    "7 days": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dni"
          }
        }
      }
    },
    "99 Languages": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "99 języków"
          }
        }
      }
    },
    "A new 3.77 GB MLX model is available for Apple silicon. Continue to AI Enhancement to download and verify it. Your current slower model will keep working unless you choose to upgrade.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępny jest nowy model MLX (3,77 GB) dla Apple silicon. Przejdź do Ulepszania AI, aby go pobrać i zweryfikować. Twój obecny, wolniejszy model będzie nadal działał, chyba że zdecydujesz się na aktualizację."
          }
        }
      }
    },
    "A new version is available and will be installed now.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępna jest nowa wersja i zostanie teraz zainstalowana."
          }
        }
      }
    },
    "ACTIVITY": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AKTYWNOŚĆ"
          }
        }
      }
    },
