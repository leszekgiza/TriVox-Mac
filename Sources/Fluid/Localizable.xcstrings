        }
      }
    },
    "AI can make mistakes. Avoid dangerous commands like deleting important files. Destructive actions will ask for confirmation.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI może popełniać błędy. Unikaj niebezpiecznych poleceń, takich jak usuwanie ważnych plików. Działania niszczące poproszą o potwierdzenie."
          }
        }
      }
    },
    "AI can make mistakes. Avoid destructive commands.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI może popełniać błędy. Unikaj poleceń niszczących dane."
          }
        }
      }
    },
    "AI provider": {
      "localizations": {
        "pl": {
          "stringUnit": {
